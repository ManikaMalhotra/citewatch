# Citewatch — environment variables
# Copy this file to .env and fill in real keys. Never commit .env.

# Required for Claude models (expand / capture / analyze / full-run / competitive)
ANTHROPIC_API_KEY=

# Optional — enables Gemini models (pro, flash)
GOOGLE_API_KEY=

# Optional — Ollama server for local embeddings (default below)
OLLAMA_BASE_URL=http://localhost:11434

# Optional — override path to config.yaml
# CITEWATCH_CONFIG=./config.yaml
